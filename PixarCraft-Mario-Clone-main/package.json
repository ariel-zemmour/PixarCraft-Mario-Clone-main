{
  "name": "react-example",
  "author": "Ariel",
  "description": "PixarCraft Mario Clone",
  "homepage": "https://ariel-zemmour.github.io/PixarCraft-Mario-Clone-main/",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port=3201 --host=0.0.0.0",
    "build": "vite build && npm run electron:compile && npm run electron:build",
    "build:web": "vite build",
    "electron:compile": "npx esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=esm --outdir=dist-electron --external:electron --external:electron-updater",
    "electron:build": "electron-builder --win",
    "deploy": "npm run build:web && npx gh-pages -d dist",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.pixarcraft.marioclone",
    "productName": "PixarCraft Mario Clone",
    "directories": {
      "output": "dist/releases"
    },
    "compression": "maximum",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "!dist/releases"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Mario-Clone-Setup.exe"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Mario-Clone.dmg"
    },
    "publish": {
      "provider": "github",
      "owner": "ariel-zemmour",
      "repo": "PixarCraft-Mario-Clone-main",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react-router-dom": "^7.18.4"
  }
}
